# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for OAuth callbacks and API endpoints.
APP_URL="MY_APP_URL"

# APP_ACCESS_PIN: Optional server-side override for the initial login PIN.
APP_ACCESS_PIN=

# STRAVA_CLIENT_ID & STRAVA_CLIENT_SECRET: Required for automatic Strava OAuth sync.
# Create an API application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
